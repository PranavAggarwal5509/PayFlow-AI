# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_DB=payflow
# Inside Docker Compose the host is "postgres". For running the backend on your machine use localhost.
DATABASE_URL=postgresql+psycopg://payflow:payflow@postgres:5432/payflow

# --- LLM Provider (mock | gemini) ---
# mock = zero-cost offline development using synthetic sample catalog. gemini = production Google Gemini API.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- URLs ---
BACKEND_BASE_URL=http://backend:8000
FRONTEND_BASE_URL=http://localhost:3000
# Used by the browser to reach FastAPI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Storage / limits ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=PayFlow
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=15

# --- Business rules ---
INR_ROUNDING_TOLERANCE=1.00
DEFAULT_ROUNDING_TOLERANCE=0.01
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP,AED,SGD
REQUIRE_GSTIN_FOR_APPROVAL=true
